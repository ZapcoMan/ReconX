{
  "name": "reconx",
  "version": "0.7.0",
  "private": true,
  "description": "面向已授权目标的前端资产与路由侦察工作台（Vue 3 + TypeScript + Vite + Element Plus，Chrome MV3）：被动指纹与敏感信息采集、主动探测与客户端路由接管核验、Dork 与资产测绘查询生成",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "gen:icons": "node --experimental-strip-types gen-icons.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.8.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.270",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^5.1.0",
    "typescript": "^5.5.0",
    "unplugin-auto-import": "^0.18.0",
    "unplugin-vue-components": "^0.27.0",
    "vite": "^5.4.0",
    "vue-tsc": "^2.1.0"
  }
}
