{
  "name": "reconx",
  "version": "0.2.0",
  "private": true,
  "description": "面向已授权目标的浏览器侦察扩展（Vue3 + TypeScript + Element Plus，MV3）",
  "type": "module",
  "scripts": {
    "dev": "vite",
